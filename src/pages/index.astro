---
import Base from '../layouts/Base.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { profile } from '../data/profile';
import { updates, publications, experience } from '../data/content';

const featured = publications.filter((p) => p.featured);
const current = experience.find((r) => r.period.includes('Present'));
---

<Base>
  <!-- Hero -->
  <section class="hero container">
    <div class="hero__text">
      <span class="eyebrow">{profile.role} · {profile.employer}</span>
      <h1>Ashutosh<br />Kakadiya</h1>
      <p class="hero__tag">{profile.tagline}</p>
      <p class="hero__intro">{profile.intro}</p>
      <div class="hero__actions">
        <a class="btn btn--primary" href={profile.resumeUrl} target="_blank" rel="noopener">
          View CV / Résumé
        </a>
        <a class="btn btn--ghost" href={`mailto:${profile.email}`}>Get in touch</a>
      </div>
      <SocialLinks class="hero__socials" />
    </div>

    <div class="hero__media">
      <div class="hero__photo-frame">
        <img
          src={profile.photo}
          alt="Portrait of Ashutosh Kakadiya"
          width="440"
          height="587"
          fetchpriority="high"
        />
      </div>
      <div class="hero__badge">
        <span class="dot"></span>
        Available for research collaborations
      </div>
    </div>
  </section>

  <!-- Currently -->
  {
    current && (
      <section class="container section--tight">
        <div class="currently reveal">
          <span class="eyebrow">Currently</span>
          <p>
            <strong>{current.title}</strong> at{' '}
            <a href={current.orgUrl} target="_blank" rel="noopener">{current.org}</a>. {current.points[0]}
          </p>
        </div>
      </section>
    )
  }

  <!-- Recent updates -->
  <section class="container section--tight">
    <div class="section__head reveal">
      <span class="eyebrow">News</span>
      <h2>Recent updates</h2>
    </div>
    <ol class="timeline">
      {
        updates.map((u) => (
          <li class="timeline__item reveal">
            <time class="timeline__date">{u.date}</time>
            <p class="timeline__body" set:html={u.html} />
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Selected work -->
  <section class="container section--tight">
    <div class="section__head reveal">
      <span class="eyebrow">Selected work</span>
      <h2>Publications</h2>
      <p>A few papers I'm proud of — the full list lives on the publications page.</p>
    </div>
    <div class="pub-grid">
      {
        featured.map((p) => (
          <article class="card card--link reveal">
            <div class="pub-meta">
              <span class="chip">{p.venue}</span>
              <span class="pub-year">{p.year}</span>
            </div>
            <h3>{p.title}</h3>
            <p class="text-muted pub-excerpt">{p.excerpt}</p>
            <div class="linklist">
              {p.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
              ))}
            </div>
          </article>
        ))
      }
    </div>
    <p class="more-link reveal">
      <a href="/publications">All publications →</a>
    </p>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: var(--space-xl);
    align-items: center;
    padding-top: clamp(2.5rem, 6vw, 5rem);
    padding-bottom: var(--space-xl);
  }
  .hero h1 {
    font-size: var(--step-4);
    margin: 0.7rem 0 0;
  }
  .hero__tag {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--heading);
    margin-top: var(--space-sm);
    max-width: 30ch;
  }
  .hero__intro {
    color: var(--muted);
    margin-top: var(--space-sm);
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: var(--space-md);
  }
  .hero__socials {
    margin-top: var(--space-md);
    margin-left: -0.4rem;
  }

  .hero__media {
    position: relative;
    justify-self: center;
  }
  .hero__photo-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    max-width: 340px;
    background: var(--surface-2);
  }
  .hero__photo-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.05);
    border-radius: inherit;
  }
  .hero__photo-frame img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  .hero__badge {
    position: absolute;
    bottom: -0.9rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    border-radius: var(--radius-pill);
    padding: 0.45rem 0.9rem;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
  }
  .hero__badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 0 3px color-mix(in srgb, #22c55e 25%, transparent);
  }

  /* Currently */
  .currently {
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    background: var(--surface);
    border-radius: var(--radius);
    padding: var(--space-md);
    box-shadow: var(--shadow-sm);
  }
  .currently p {
    margin-top: 0.35rem;
    color: var(--muted);
  }
  .currently strong {
    color: var(--heading);
  }

  /* Timeline */
  .timeline {
    list-style: none;
    padding: 0;
    border-left: 2px solid var(--border);
    margin-left: 0.4rem;
  }
  .timeline__item {
    position: relative;
    padding: 0 0 var(--space-md) var(--space-md);
  }
  .timeline__item::before {
    content: '';
    position: absolute;
    left: calc(-0.4rem - 1px);
    top: 0.55rem;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }
  .timeline__date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent-ink);
    margin-bottom: 0.2rem;
  }
  .timeline__body {
    color: var(--text);
  }

  /* Publications grid */
  .pub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-md);
  }
  .pub-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .pub-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .pub-excerpt {
    margin: 0.5rem 0 var(--space-sm);
    font-size: var(--step--1);
  }
  .more-link {
    margin-top: var(--space-md);
  }
  .more-link a {
    font-weight: 500;
    text-decoration: none;
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
      text-align: left;
    }
    .hero__media {
      order: -1;
      justify-self: start;
    }
    .hero__photo-frame {
      max-width: 240px;
    }
    .hero__badge {
      left: auto;
      right: 0;
      transform: none;
    }
  }
</style>
