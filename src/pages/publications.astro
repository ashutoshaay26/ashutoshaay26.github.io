---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { publications } from '../data/content';
import { profile } from '../data/profile';

const sorted = [...publications].sort((a, b) => b.year - a.year);
---

<Base title="Publications" description="Peer-reviewed publications by Ashutosh Kakadiya.">
  <PageHeader eyebrow="Publications" title="Publications">
    <p class="lead">
      Peer-reviewed work in relational learning, recommendation, and generative models. You can also
      find my articles on <a href={profile.scholar} target="_blank" rel="noopener">Google Scholar</a>.
    </p>
  </PageHeader>

  <section class="container section--tight">
    <ol class="pub-list">
      {
        sorted.map((p) => (
          <li class="pub reveal">
            <div class="pub__year">
              <span>{p.year}</span>
            </div>
            <div class="pub__main">
              <h2>{p.title}</h2>
              <p class="pub__venue">{p.venue}</p>
              <p class="text-muted pub__excerpt">{p.excerpt}</p>
              <div class="tag-row pub__tags">
                {p.tags.map((t) => <span class="chip">{t}</span>)}
              </div>
              <div class="linklist">
                {p.links.map((l) => (
                  <a href={l.href} target="_blank" rel="noopener">{l.label}</a>
                ))}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .pub-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .pub {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-md);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--border);
  }
  .pub:last-child {
    border-bottom: 1px solid var(--border);
  }
  .pub__year span {
    font-family: var(--font-mono);
    font-size: var(--step-1);
    color: var(--accent-ink);
  }
  .pub h2 {
    font-size: var(--step-1);
    line-height: 1.25;
  }
  .pub__venue {
    color: var(--heading);
    font-weight: 500;
    margin-top: 0.3rem;
    font-size: var(--step--1);
  }
  .pub__excerpt {
    margin-top: 0.55rem;
    font-size: var(--step--1);
    max-width: var(--measure);
  }
  .pub__tags {
    margin-top: var(--space-sm);
  }
  .pub .linklist {
    margin-top: var(--space-sm);
  }
  @media (max-width: 560px) {
    .pub {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
