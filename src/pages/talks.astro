---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { talks } from '../data/content';
---

<Base title="Talks" description="Talks, workshops, and guest lectures by Ashutosh Kakadiya.">
  <PageHeader
    eyebrow="Talks & Workshops"
    title="Talks"
    lead="Guest lectures and hands-on workshops on machine learning, clustering, and applied deep learning."
  />

  <section class="container section--tight">
    <div class="talks">
      {
        talks.map((t) => (
          <article class="card talk reveal">
            <div class="talk__meta">
              <span class="chip">{t.date}</span>
              <span class="text-muted talk__loc">{t.location}</span>
            </div>
            <h2>{t.title}</h2>
            <p class="talk__venue">{t.venue}</p>
            <ul class="talk__points">
              {t.points.map((pt) => <li>{pt}</li>)}
            </ul>
            {t.link && (
              <div class="linklist">
                <a href={t.link.href} target="_blank" rel="noopener">{t.link.label}</a>
              </div>
            )}
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .talks {
    display: grid;
    gap: var(--space-md);
  }
  .talk__meta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.6rem;
  }
  .talk__loc {
    font-size: var(--step--1);
  }
  .talk h2 {
    font-size: var(--step-1);
  }
  .talk__venue {
    color: var(--heading);
    font-weight: 500;
    margin-top: 0.25rem;
    font-size: var(--step--1);
  }
  .talk__points {
    margin: var(--space-sm) 0 0;
    padding-left: 1.15rem;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .talk__points li + li {
    margin-top: 0.3rem;
  }
  .talk .linklist {
    margin-top: var(--space-sm);
  }
</style>
