---
import { socials } from '../data/profile';

interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: className = '' } = Astro.props;
---

<div class={`socials ${className}`}>
  {
    socials.map((s) => (
      <a
        href={s.href}
        class="socials__link"
        aria-label={s.label}
        title={s.label}
        rel={s.href.startsWith('http') ? 'noopener noreferrer' : undefined}
        target={s.href.startsWith('http') ? '_blank' : undefined}
      >
        <svg
          width={size}
          height={size}
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d={s.icon} />
        </svg>
      </a>
    ))
  }
</div>

<style>
  .socials {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }
  .socials__link {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--muted);
    border: 1px solid transparent;
    transition: color var(--transition), background var(--transition),
      border-color var(--transition), transform var(--transition);
  }
  .socials__link:hover {
    color: var(--accent-ink);
    background: var(--surface);
    border-color: var(--border);
    transform: translateY(-2px);
  }
</style>
