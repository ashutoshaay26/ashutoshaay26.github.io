---
import SocialLinks from './SocialLinks.astro';
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container foot">
    <div>
      <p class="foot__name">{profile.name}</p>
      <p class="text-muted foot__role">
        {profile.role} · <a href={profile.employerUrl} target="_blank" rel="noopener">{profile.employer}</a>
      </p>
    </div>
    <SocialLinks size={18} />
  </div>
  <div class="container foot__base">
    <span class="text-muted">© {year} · Built with Astro</span>
    <a class="text-muted" href="#top">Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: var(--space-2xl);
    padding-block: var(--space-lg) var(--space-md);
    background: var(--surface);
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-md);
  }
  .foot__name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    color: var(--heading);
  }
  .foot__role {
    font-size: var(--step--1);
  }
  .foot__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: var(--space-md);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .foot__base a {
    text-decoration: none;
  }
</style>
